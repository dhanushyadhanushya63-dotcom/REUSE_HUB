{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "▶ Run ReUseHub Web Server (Node.js)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/server.js",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "▶ Run Java Spring Boot Backend",
      "request": "launch",
      "mainClass": "com.reusehub.marketplace.MarketplaceApplication",
      "projectName": "reusehub-marketplace"
    }
  ]
}
